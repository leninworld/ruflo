+      entry: { id: row.id, key: entries[row.index].key, namespace: entries[row.index].namespace ?? 'default', content: entries[row.index].value },
+      embedding: row.embedding.embedding, upsert: entries[row.index].upsert !== false,
+    })), dbPath);
+    for (const row of committed) {
+      if (!indexed.available) results[row.index].indexWarning = 'Optional HNSW unavailable; vectors remain in SQLite';
+      else if (indexed.failed.includes(row.id)) {
+        results[row.index].success = false;
+        results[row.index].indexWarning = 'Row persisted, but HNSW indexing did not complete';
+      }
+    }
+  } catch (error) {
+    for (const row of committed) {
+      results[row.index].success = false;
+      results[row.index].indexWarning = `Row persisted, but HNSW indexing failed: ${message(error)}`;
+    }
+  }
