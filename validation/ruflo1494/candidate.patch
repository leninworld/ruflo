+/** Canonical raw-sql.js row mutation, shared by single and bulk writes. */
+export interface MemoryRowDatabase {
+  run(sql: string, params?: Array<string | number | null>): unknown;
+  prepare(sql: string): { bind(values: Array<string | number | null>): void; step(): boolean; get(): unknown[]; free(): void };
+}
+
+export interface MemoryRow {
+  id: string;
+  key: string;
+  namespace: string;
+  value: string;
+  tags: string[];
+  metadata?: Record<string, unknown>;
+  ttl?: number;
+  upsert: boolean;
+  provenanceType?: string;
+  now: number;
+  embeddingJson: string | null;
+  embeddingDimensions: number | null;
+  embeddingModel: string | null;
+}
+
+export function insertSqlJsMemoryRow(
+  db: MemoryRowDatabase,
+  row: MemoryRow,
+  validProvenance: (value: unknown) => boolean,
+): void {
+  let provenance = row.provenanceType ?? 'unknown';
+  if (row.upsert && row.provenanceType === undefined) {
+    try {
+      const statement = db.prepare('SELECT provenance_type FROM memory_entries WHERE namespace = ? AND key = ? LIMIT 1');
+      try {
+        statement.bind([row.namespace, row.key]);
+        if (statement.step()) {
+          const existing = statement.get()[0];
+          provenance = validProvenance(existing) ? existing as string : 'unknown';
+        }
+      } finally { statement.free(); }
+    } catch { /* legacy schema or new row — retain unknown */ }
+  }
+  try {
+    db.run('INSERT OR IGNORE INTO vector_indexes (id, name, dimensions) VALUES (?, ?, ?)',
+      [row.namespace, row.namespace, row.embeddingDimensions ?? 384]);
+  } catch { /* vector_indexes may be absent on a legacy database */ }
+  const verb = row.upsert ? 'INSERT OR REPLACE' : 'INSERT';
+  db.run(`${verb} INTO memory_entries (
+    id, key, namespace, content, type,
+    embedding, embedding_dimensions, embedding_model,
+    tags, metadata, provenance_type, created_at, updated_at, expires_at, status
+  ) VALUES (?, ?, ?, ?, 'semantic', ?, ?, ?, ?, ?, ?, ?, ?, ?, 'active')`, [
+    row.id, row.key, row.namespace, row.value,
+    row.embeddingJson, row.embeddingDimensions, row.embeddingModel,
+    row.tags.length > 0 ? JSON.stringify(row.tags) : null,
+    JSON.stringify(row.metadata ?? {}), provenance, row.now, row.now,
+    row.ttl ? row.now + row.ttl * 1000 : null,
+  ]);
+}
