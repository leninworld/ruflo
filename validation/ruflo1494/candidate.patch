+            } finally { check.free(); }
+            db.run('RELEASE memory_batch_row');
+            committed.push(row);
+          } catch (error) {
+            db.run('ROLLBACK TO memory_batch_row');
+            db.run('RELEASE memory_batch_row');
+            results[row.index].error = message(error);
+          }
+        }
+        db.run('COMMIT');
+        // Verify all logical slots after the transaction, before exporting it.
+        // This also catches an unexpected ID collision replacing an earlier row.
+        let verified = 0;
+        for (const row of committed) {
+          const entry = entries[row.index];
+          const check = db.prepare('SELECT id FROM memory_entries WHERE namespace = ? AND key = ?');
+          try {
+            check.bind([entry.namespace ?? 'default', entry.key]);
+            if (!check.step() || check.get()[0] !== row.id) throw new Error('Committed batch row verification failed');
+            verified++;
+          } finally { check.free(); }
+        }
+        if (verified !== committed.length) throw new Error('Committed batch row count mismatch');
+        writeDbImagePreservingFormat(path, db.export());
+      } finally { db.close(); }
